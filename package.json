{
  "name": "@waimakers/nanobanana-mcp",
  "version": "0.2.0",
  "description": "Local MCP server for Gemini image generation",
  "private": true,
  "type": "module",
  "bin": {
    "nanobanana-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.18.0",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "mcp",
    "gemini",
    "nanobanana",
    "image-generation",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waimakers/nanobanana-mcp.git"
  }
}
